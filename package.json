{
  "name": "healthchain-root",
  "version": "1.0.0",
  "description": "HealthChain: Hyperledger Fabric Medical Document Management & Verification",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && npm start",
    "network:up": "powershell -ExecutionPolicy Bypass -File ./fabric-network/scripts/network.ps1 -Mode up",
    "network:down": "powershell -ExecutionPolicy Bypass -File ./fabric-network/scripts/network.ps1 -Mode down"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.11.1",
    "@hyperledger/fabric-gateway": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "keywords": [
    "hyperledger",
    "fabric",
    "blockchain",
    "healthcare",
    "medical",
    "verification"
  ],
  "author": "HealthChain Team",
  "license": "Apache-2.0"
}
