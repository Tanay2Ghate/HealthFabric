# =============================================================================
# HealthChain Backend – Environment Variables
# Copy this file to .env and fill in all values before running the server.
# NEVER commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development    # development | production | test

# -----------------------------------------------------------------------------
# JSON Web Token
# -----------------------------------------------------------------------------
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# MySQL Database
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=healthchain
DB_USER=healthchain_app
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# -----------------------------------------------------------------------------
# Hyperledger Fabric – Channel & Chaincode
# -----------------------------------------------------------------------------
FABRIC_CHANNEL_NAME=healthchainchannel
FABRIC_CHAINCODE_NAME=healthchain-cc

# -----------------------------------------------------------------------------
# Hyperledger Fabric – Peer Identity
# -----------------------------------------------------------------------------
# MSP ID of the organization this backend belongs to (e.g., HospitalAMSP)
FABRIC_MSP_ID=HospitalAMSP

# Peer gRPC endpoint (host:port)
FABRIC_PEER_ENDPOINT=peer0.hospitala.example.com:7051

# TLS SNI host alias for the peer (usually same as hostname portion)
FABRIC_PEER_HOST_ALIAS=peer0.hospitala.example.com

# -----------------------------------------------------------------------------
# Hyperledger Fabric – TLS & Identity Certificates
# Paths are relative to the backend/ directory unless absolute.
# -----------------------------------------------------------------------------
# Path to PEM-encoded TLS CA certificate for the peer
TLS_CERT_PATH=../fabric/organizations/hospitala/peers/peer0.hospitala.example.com/tls/ca.crt

# Path to PEM-encoded admin identity certificate
ADMIN_CERT_PATH=../fabric/organizations/hospitala/users/Admin@hospitala.example.com/msp/signcerts/cert.pem

# Path to PEM-encoded admin private key (keep this extremely secret)
ADMIN_KEY_PATH=../fabric/organizations/hospitala/users/Admin@hospitala.example.com/msp/keystore/server.key

# -----------------------------------------------------------------------------
# Mock / Dev Mode
# Set to true when Fabric network is not available (e.g., local dev without Docker)
# -----------------------------------------------------------------------------
FABRIC_MOCK_MODE=true

# -----------------------------------------------------------------------------
# File Encryption
# -----------------------------------------------------------------------------
# 32-byte (256-bit) master key in hex; used for AES-256-GCM file encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production, use a proper KMS (AWS KMS, GCP Cloud KMS, HashiCorp Vault).
ENCRYPTION_MASTER_KEY=REPLACE_WITH_64_HEX_CHARS_32_BYTES

# Directory where encrypted medical files are stored (relative to backend/)
UPLOAD_DIR=uploads/encrypted

# Maximum file size in megabytes (enforced by multer and fileService)
MAX_FILE_SIZE_MB=50

# Directory where per-document AES keys are stored (relative to backend/)
# In production replace with a KMS; this directory should be on encrypted storage.
KEYS_DIR=.keys
