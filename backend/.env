PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=4f8a192bc7e4d82f1b0a539c82e6d9f041a7c3b28e5d1a9f0e2b4c6d8e0a2f4c6e8b0d2a4f6c8e0b2d4f6a8c0e2b4d6f8a0c2e4b6d8f0a2c4e6b8d0a2f4c6e8b
JWT_EXPIRES_IN=8h

# SQLite Database (local self-contained file)
DB_PATH=healthchain.db

# Hyperledger Fabric Settings
FABRIC_CHANNEL_NAME=healthchainchannel
FABRIC_CHAINCODE_NAME=healthchain-cc
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.hospitala.healthchain.com
TLS_CERT_PATH=../fabric-network/organizations/peerOrganizations/hospitala.healthchain.com/peers/peer0.hospitala.healthchain.com/tls/ca.crt
ADMIN_CERT_PATH=../fabric-network/organizations/peerOrganizations/hospitala.healthchain.com/users/Admin@hospitala.healthchain.com/msp/signcerts/cert.pem
ADMIN_KEY_PATH=../fabric-network/organizations/peerOrganizations/hospitala.healthchain.com/users/Admin@hospitala.healthchain.com/msp/keystore/priv_sk

# Mock mode toggles automatically when Fabric is offline
FABRIC_MOCK_MODE=true

# 32-byte Master Encryption Key (64 hex characters)
ENCRYPTION_MASTER_KEY=9e8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a

